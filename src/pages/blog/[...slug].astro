---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '~/layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog-pt', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = (await getCollection('blog-pt', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const idx = allPosts.findIndex(p => p.id === post.id);
const nextPostData = allPosts[idx + 1] ?? null;
const nextPost = nextPostData
  ? { slug: nextPostData.id, title: nextPostData.data.title, pubDate: nextPostData.data.pubDate, tags: nextPostData.data.tags }
  : null;
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  heroImage={post.data.heroImage}
  tags={post.data.tags}
  headings={headings}
  nextPost={nextPost}
>
  <Content />
</BlogPostLayout>
