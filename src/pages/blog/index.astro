---
import '~/styles/blog.css';
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import PostRow from '~/components/PostRow.astro';
import { useTranslations } from '~/i18n/utils';

const lang = 'pt-br' as const;
const t = useTranslations(lang);

const allPosts = (await getCollection('blog-pt', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const [featured, ...archivePosts] = allPosts;
const total = allPosts.length;

const tagCounts = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

const showing = t('blog.filter.showing');
const of = t('blog.filter.of');
---

<BaseLayout
  title="Blog — Michel Banagouro · CTO @ Leanwork"
  description={t('blog.subtitle')}
  lang={lang}
>

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="container page-hero__inner">
      <span class="page-hero__eyebrow">{t('blog.hero.eyebrow')}</span>
      <h1 class="page-hero__title" set:html={t('blog.hero.title')} />
      <p class="page-hero__lede">{t('blog.hero.lede')}</p>
      <div class="page-hero__meta">
        <span><strong>{total}</strong> {t('blog.hero.published')}</span>
        <span><strong>{t('blog.hero.rss_label')}</strong> {t('blog.hero.rss_note')}</span>
      </div>
    </div>
  </section>

  <!-- FILTER BAR -->
  {sortedTags.length > 0 && (
    <nav class="filters" aria-label={t('blog.filter.aria')}>
      <div class="container">
        <div class="filters__inner">
          <span class="filters__label">{t('blog.filter.label')}</span>
          <button class="chip-btn is-active" data-tag="all">
            {t('blog.filter.all')} <span class="count">{total}</span>
          </button>
          {sortedTags.map(([tag, count]) => (
            <button class="chip-btn" data-tag={tag}>
              {tag} <span class="count">{String(count).padStart(2, '0')}</span>
            </button>
          ))}
          <div class="filters__spacer"></div>
          <span class="filters__count" id="filtersCount">
            {t('blog.filter.showing')} {total} {t('blog.filter.of')} {total}
          </span>
        </div>
      </div>
    </nav>
  )}

  <!-- FEATURED POST -->
  {featured && (
    <section class="featured-wrap" aria-label={t('blog.featured.aria')} id="featuredWrap">
      <div class="container">
        <PostCard
          slug={featured.id}
          title={featured.data.title}
          description={featured.data.description}
          pubDate={featured.data.pubDate}
          tags={featured.data.tags}
          lang={lang}
          postIndex={total}
        />
      </div>
    </section>
  )}

  <!-- ARCHIVE LIST -->
  {archivePosts.length > 0 && (
    <section aria-label={t('blog.archive.aria')}>
      <div class="container">
        <div class="archive" id="archive">
          {archivePosts.map((post) => (
            <PostRow
              slug={post.id}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              lang={lang}
            />
          ))}
        </div>
        <div class="archive-empty" id="archiveEmpty">{t('blog.archive.empty')}</div>
      </div>
    </section>
  )}

</BaseLayout>

<script is:inline define:vars={{ total, showing, of }}>
  (function () {
    const chips = document.querySelectorAll('.chip-btn[data-tag]');
    const rows = document.querySelectorAll('.archive .row');
    const featuredEl = document.querySelector('.featured');
    const featuredWrap = document.getElementById('featuredWrap');
    const countEl = document.getElementById('filtersCount');
    const empty = document.getElementById('archiveEmpty');

    if (!chips.length) return;

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        const tag = chip.dataset.tag;
        chips.forEach(function (c) { c.classList.toggle('is-active', c === chip); });

        let visible = 0;

        if (featuredEl && featuredWrap) {
          const matchF = tag === 'all' || featuredEl.dataset.tag === tag;
          featuredWrap.style.display = matchF ? '' : 'none';
          if (matchF) visible++;
        }

        rows.forEach(function (row) {
          const match = tag === 'all' || row.dataset.tag === tag;
          row.classList.toggle('is-hidden', !match);
          if (match) visible++;
        });

        if (empty) empty.classList.toggle('is-shown', visible === 0);

        if (countEl) {
          if (tag === 'all') {
            countEl.textContent = showing + ' ' + total + ' ' + of + ' ' + total;
          } else {
            const countSpan = chip.querySelector('.count');
            const tagTotal = countSpan ? parseInt(countSpan.textContent, 10) : visible;
            countEl.textContent = showing + ' ' + visible + ' ' + of + ' ' + tagTotal;
          }
        }
      });
    });
  })();
</script>
