---
import '~/styles/projects.css';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { useTranslations } from '~/i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const links = [
  { label: 'ASP.NET PRO',  url: 'https://aspnetpro.com.br',             hint: '.NET training' },
  { label: 'GitHub',       url: 'https://github.com/mbanagouro',        hint: 'Open source code' },
  { label: 'YouTube',      url: 'https://www.youtube.com/@mbanagouro',  hint: 'Videos and tutorials' },
  { label: 'Instagram',    url: 'https://www.instagram.com/mbanagouro', hint: 'Behind-the-scenes' },
];
---

<BaseLayout title={t('links.title')} description={t('links.subtitle')} lang={lang}>

  <section class="page-hero">
    <div class="container">
      <span class="page-hero__eyebrow">{t('links.hero.eyebrow')}</span>
      <h1 class="page-hero__title" set:html={t('links.hero.title')} />
      <p class="page-hero__lede">{t('links.hero.lede')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="links-list">
        {links.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel="noopener noreferrer" class="link-item">
              <div>
                <p class="link-item__label">{l.label}</p>
                <p class="link-item__hint">{l.hint}</p>
              </div>
              <svg class="link-item__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>
