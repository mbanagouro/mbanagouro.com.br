---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { useTranslations } from '~/i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout title={t('about.title')} description={t('about.subtitle')} lang={lang}>
  <header class="mb-10">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{t('about.title')}</h1>
    <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">{t('about.subtitle')}</p>
  </header>

  <div class="prose-custom">
    <p>
      I'm <strong>Michel Banagouro</strong>, a software engineer focused on ASP.NET, .NET, and web architecture.
      Founder of <a href="https://aspnetpro.com.br" target="_blank" rel="noopener noreferrer">ASP.NET PRO</a>,
      where I help Brazilian developers grow their careers with .NET.
    </p>

    <h2>What I'm working on</h2>
    <ul>
      <li>
        <strong>ASP.NET PRO</strong> — technical training for .NET developers in Brazil.
      </li>
      <li>
        <strong>Video content</strong> — I publish on <a href="https://www.youtube.com/@mbanagouro" target="_blank" rel="noopener noreferrer">YouTube</a>
        about development, architecture and applied AI.
      </li>
      <li>
        <strong>Open source</strong> — I maintain projects on <a href="https://github.com/mbanagouro" target="_blank" rel="noopener noreferrer">GitHub</a>.
      </li>
    </ul>

    <h2>Background</h2>
    <p>
      <em>Under construction.</em> Edit this content at <code>src/pages/en/about.astro</code> with your full bio,
      career timeline, companies, talks, recommended books, etc.
    </p>

    <h2>Get in touch</h2>
    <p>
      For partnerships, mentoring or press, reach out through any of the channels on the
      <a href="/en/links">links</a> page.
    </p>
  </div>
</BaseLayout>
