---
import '~/styles/projects.css';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import { useTranslations } from '~/i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const projects = [
  {
    name: 'ASP.NET PRO',
    description: 'Technical training platform for .NET developers in Brazil.',
    href: 'https://aspnetpro.com.br',
    stack: ['ASP.NET', '.NET', 'Education'],
  },
  {
    name: 'Open Source on GitHub',
    description: 'Public repositories with libraries, templates and examples for the .NET community.',
    href: 'https://github.com/mbanagouro',
    stack: ['Open Source', 'C#', '.NET'],
  },
  {
    name: 'YouTube channel',
    description: 'Videos on software development, architecture, AI and career in tech.',
    href: 'https://www.youtube.com/@mbanagouro',
    stack: ['Content', 'YouTube'],
  },
];
---

<BaseLayout title={t('projects.title')} description={t('projects.subtitle')} lang={lang}>

  <section class="page-hero">
    <div class="container">
      <span class="page-hero__eyebrow">{t('projects.hero.eyebrow')}</span>
      <h1 class="page-hero__title" set:html={t('projects.hero.title')} />
      <p class="page-hero__lede">{t('projects.hero.lede')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="proj-grid">
        {projects.map((p) => <ProjectCard {...p} visitLabel={t('projects.visit')} />)}
      </div>
    </div>
  </section>

</BaseLayout>
