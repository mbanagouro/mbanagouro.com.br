---
import '~/styles/projects.css';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import { useTranslations } from '~/i18n/utils';

const lang = 'pt-br' as const;
const t = useTranslations(lang);

const projects = [
  {
    name: 'ASP.NET PRO',
    description: 'Plataforma de formação técnica para desenvolvedores .NET no Brasil.',
    href: 'https://aspnetpro.com.br',
    stack: ['ASP.NET', '.NET', 'Educação'],
  },
  {
    name: 'Open Source no GitHub',
    description: 'Repositórios públicos com libs, templates e exemplos para a comunidade .NET.',
    href: 'https://github.com/mbanagouro',
    stack: ['Open Source', 'C#', '.NET'],
  },
  {
    name: 'Canal no YouTube',
    description: 'Vídeos sobre desenvolvimento, arquitetura, IA e carreira em tech.',
    href: 'https://www.youtube.com/@mbanagouro',
    stack: ['Conteúdo', 'YouTube'],
  },
];
---

<BaseLayout title={t('projects.title')} description={t('projects.subtitle')} lang={lang}>

  <section class="page-hero">
    <div class="container">
      <span class="page-hero__eyebrow">{t('projects.hero.eyebrow')}</span>
      <h1 class="page-hero__title" set:html={t('projects.hero.title')} />
      <p class="page-hero__lede">{t('projects.hero.lede')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="proj-grid">
        {projects.map((p) => <ProjectCard {...p} visitLabel={t('projects.visit')} />)}
      </div>
    </div>
  </section>

</BaseLayout>
