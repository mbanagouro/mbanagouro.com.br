---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BlogCard from '~/components/BlogCard.astro';
import SocialLinks from '~/components/SocialLinks.astro';
import { useTranslations, localizedPath } from '~/i18n/utils';

const lang = 'pt-br' as const;
const t = useTranslations(lang);

const latestPosts = (await getCollection('blog-pt', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Michel Banagouro — Engenheiro de Software"
  description={t('home.intro')}
  lang={lang}
>
  <section class="grid items-center gap-10 md:grid-cols-[auto_1fr]">
    <div class="flex justify-center md:justify-start">
      <div class="relative h-40 w-40 overflow-hidden rounded-full border-4 border-brand-500/20 bg-gradient-to-br from-brand-400 to-brand-600 shadow-lg sm:h-48 sm:w-48">
        <span class="absolute inset-0 flex items-center justify-center text-5xl font-bold text-white">MB</span>
      </div>
    </div>

    <div>
      <p class="mb-2 text-sm uppercase tracking-wider text-brand-600 dark:text-brand-400">
        Olá, eu sou
      </p>
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 sm:text-5xl">
        Michel Banagouro
      </h1>
      <p class="mt-3 text-lg text-zinc-700 dark:text-zinc-300">{t('home.tagline')}</p>
      <p class="mt-4 max-w-2xl text-zinc-600 dark:text-zinc-400">{t('home.intro')}</p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={localizedPath('/sobre', lang)}
          class="inline-flex items-center rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white no-underline shadow-sm hover:bg-brand-700"
        >
          {t('home.cta.about')}
        </a>
        <a
          href={localizedPath('/blog', lang)}
          class="inline-flex items-center rounded-md border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-700 no-underline hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800"
        >
          {t('home.cta.blog')}
        </a>
      </div>

      <div class="mt-6">
        <SocialLinks />
      </div>
    </div>
  </section>

  {latestPosts.length > 0 && (
    <section class="mt-20">
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="text-2xl font-bold tracking-tight">{t('home.latest_posts')}</h2>
        <a href={localizedPath('/blog', lang)} class="text-sm font-medium text-brand-600 dark:text-brand-400">
          {t('home.see_all')} →
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map((post) => (
          <BlogCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            lang={lang}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
