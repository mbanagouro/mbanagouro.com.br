---
import '~/styles/404.css';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
import { useTranslations, getLangFromUrl, localizedPath } from '~/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('404.title')} description={t('404.message')} lang={lang} noindex>
  <div class="not-found">
    <div class="not-found__inner">
      <p class="not-found__code">404</p>
      <h1 class="not-found__title">{t('404.title')}</h1>
      <p class="not-found__message">{t('404.message')}</p>
      <div class="not-found__cta">
        <Button href={localizedPath('/', lang)} variant="acc" size="lg">
          ← {t('404.home')}
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
