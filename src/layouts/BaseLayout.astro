---
import '~/styles/tokens.css';
import '~/styles/base.css';
import '~/styles/site.css';
import SEO from '~/components/SEO.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import GoogleAnalytics from '~/components/GoogleAnalytics.astro';
import MetaPixel from '~/components/MetaPixel.astro';
import { getLangFromUrl, htmlLang } from '~/i18n/utils';
import type { Lang } from '~/i18n/ui';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const detectedLang = getLangFromUrl(Astro.url);
const {
  title,
  description,
  lang = detectedLang,
  image,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Michel Banagouro — Blog (PT)" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Michel Banagouro — Blog (EN)" href="/en/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
    />

    <SEO
      title={title}
      description={description}
      lang={lang}
      image={image}
      type={type}
      publishedTime={publishedTime}
      noindex={noindex}
    />

    <GoogleAnalytics />
    <MetaPixel />
  </head>
  <body>
    <a href="#main" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;focus:position:static;focus:width:auto;focus:height:auto">
      Pular para o conteúdo
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
