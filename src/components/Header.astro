---
import { useTranslations, getLangFromUrl, localizedPath } from '~/i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const aboutSlug = lang === 'pt-br' ? 'sobre' : 'about';
const projectsSlug = lang === 'pt-br' ? 'projetos' : 'projects';

const nav = [
  { href: localizedPath('/', lang), label: t('nav.home') },
  { href: localizedPath(`/${aboutSlug}`, lang), label: t('nav.about') },
  { href: localizedPath('/blog', lang), label: t('nav.blog') },
  { href: localizedPath(`/${projectsSlug}`, lang), label: t('nav.projects') },
  { href: localizedPath('/links', lang), label: t('nav.links') },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-zinc-200/70 bg-white/80 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-950/80">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={localizedPath('/', lang)} class="flex items-center gap-2 no-underline">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-brand-500 font-bold text-white">
        MB
      </span>
      <span class="hidden text-sm font-semibold text-zinc-900 dark:text-zinc-100 sm:inline">
        Michel Banagouro
      </span>
    </a>

    <nav class="hidden md:block" aria-label="Principal">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => {
            const itemPath = item.href.replace(/\/$/, '') || '/';
            const active = currentPath === itemPath;
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'rounded-md px-3 py-1.5 text-sm font-medium no-underline transition-colors',
                    active
                      ? 'bg-brand-50 text-brand-700 dark:bg-brand-500/10 dark:text-brand-300'
                      : 'text-zinc-600 hover:text-brand-600 dark:text-zinc-300 dark:hover:text-brand-400',
                  ]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher />
      <ThemeToggle />
      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-zinc-600 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-900 md:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-zinc-200/70 bg-white dark:border-zinc-800/70 dark:bg-zinc-950 md:hidden" aria-label="Mobile">
    <ul class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-3 sm:px-6">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-md px-3 py-2 text-sm font-medium text-zinc-700 no-underline hover:bg-zinc-100 dark:text-zinc-200 dark:hover:bg-zinc-900"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      const open = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!open));
    });
  })();
</script>
