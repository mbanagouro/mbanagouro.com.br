---
interface Props {
  name: string;
  description: string;
  href: string;
  stack?: string[];
  visitLabel: string;
}

const { name, description, href, stack = [], visitLabel } = Astro.props;
---

<article class="flex flex-col rounded-xl border border-zinc-200 bg-white p-6 transition-colors hover:border-brand-400 dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-brand-500">
  <h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">{name}</h3>
  <p class="mt-2 flex-1 text-sm text-zinc-600 dark:text-zinc-400">{description}</p>
  {stack.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-1.5">
      {stack.map((s) => (
        <li class="rounded bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-500/10 dark:text-brand-300">
          {s}
        </li>
      ))}
    </ul>
  )}
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-4 inline-flex w-fit items-center gap-1 text-sm font-medium text-brand-600 no-underline hover:underline dark:text-brand-400"
  >
    {visitLabel}
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 17 17 7" />
      <path d="M7 7h10v10" />
    </svg>
  </a>
</article>
