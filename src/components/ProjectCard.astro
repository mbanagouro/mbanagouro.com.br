---
interface Props {
  name: string;
  description: string;
  href: string;
  stack?: string[];
  visitLabel: string;
}

const { name, description, href, stack = [], visitLabel } = Astro.props;
---

<article class="proj-card">
  <h3 class="proj-card__name">{name}</h3>
  <p class="proj-card__desc">{description}</p>
  {stack.length > 0 && (
    <ul class="proj-card__chips">
      {stack.map((s) => <li><span class="chip chip--accent">{s}</span></li>)}
    </ul>
  )}
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="proj-card__link"
  >
    {visitLabel}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 17 17 7" />
      <path d="M7 7h10v10" />
    </svg>
  </a>
</article>
