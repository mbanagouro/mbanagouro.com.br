---
interface Props {
  href?: string;
  variant?: 'primary' | 'acc' | 'secondary' | 'ghost' | 'inverse' | 'outline-dark';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn-${variant}`, size !== 'md' ? `btn-${size}` : '', className]
  .filter(Boolean)
  .join(' ');
---

{href
  ? <a href={href} class={classes} {...rest}><slot /></a>
  : <button type={type} class={classes} {...rest}><slot /></button>
}
