---
// GA4 tag — only emitted when PUBLIC_GA4_ID is defined.
// Loads in production builds only to keep dev/preview clean.
const gaId = import.meta.env.PUBLIC_GA4_ID;
const enabled = !!gaId && import.meta.env.PROD;
---

{
  enabled && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
      <script is:inline define:vars={{ gaId }}>
        {`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId, { anonymize_ip: true });
        `}
      </script>
    </>
  )
}
