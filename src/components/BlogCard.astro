---
import type { Lang } from '~/i18n/ui';
import { localizedPath, useTranslations } from '~/i18n/utils';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  lang: Lang;
}

const { slug, title, description, pubDate, tags = [], lang } = Astro.props;
const t = useTranslations(lang);

const locale = lang === 'pt-br' ? 'pt-BR' : 'en-US';
const formatted = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'short', day: '2-digit' }).format(pubDate);
const href = localizedPath(`/blog/${slug}`, lang);
---

<article class="group rounded-xl border border-zinc-200 bg-white p-6 transition-colors hover:border-brand-400 dark:border-zinc-800 dark:bg-zinc-900/40 dark:hover:border-brand-500">
  <a href={href} class="no-underline">
    <p class="text-xs uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
      <time datetime={pubDate.toISOString()}>{formatted}</time>
    </p>
    <h2 class="mt-2 text-xl font-semibold text-zinc-900 group-hover:text-brand-600 dark:text-zinc-100 dark:group-hover:text-brand-400">
      {title}
    </h2>
    <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{description}</p>
    {tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
            #{tag}
          </li>
        ))}
      </ul>
    )}
    <p class="mt-4 text-sm font-medium text-brand-600 dark:text-brand-400">
      {t('blog.read_more')} →
    </p>
  </a>
</article>
