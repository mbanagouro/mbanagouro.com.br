---
import type { Lang } from '~/i18n/ui';
import { localizedPath } from '~/i18n/utils';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  lang: Lang;
}

const { slug, title, description, pubDate, tags, lang } = Astro.props;
const href = localizedPath(`/blog/${slug}`, lang);
const locale = lang === 'pt-br' ? 'pt-BR' : 'en-US';
const day = pubDate.toLocaleDateString(locale, { day: '2-digit', month: 'short' });
const year = pubDate.getFullYear();
const primaryTag = tags[0] ?? '';
---

<a href={href} class="row" data-tag={primaryTag}>
  <div class="row__date">
    <strong>{day}</strong>{year}
  </div>
  <div>
    <div class="row__title">{title}</div>
    <div class="row__excerpt">{description}</div>
  </div>
  <div class="row__meta">
    {primaryTag && <span class="row__tag">{primaryTag}</span>}
  </div>
  <div></div>
  <span class="row__arrow" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>
