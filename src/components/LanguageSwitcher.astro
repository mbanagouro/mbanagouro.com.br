---
import { getLangFromUrl, getAlternatePath } from '~/i18n/utils';
import { languages, type Lang } from '~/i18n/ui';

const currentLang = getLangFromUrl(Astro.url);
const entries = Object.entries(languages) as [Lang, string][];
---

<div class="flex items-center gap-1 text-sm">
  {
    entries.map(([code, label], i) => (
      <>
        {i > 0 && <span class="text-zinc-300 dark:text-zinc-700">/</span>}
        <a
          href={getAlternatePath(Astro.url, code)}
          class:list={[
            'rounded px-1.5 py-0.5 no-underline transition-colors',
            code === currentLang
              ? 'font-semibold text-brand-600 dark:text-brand-400'
              : 'text-zinc-500 hover:text-brand-600 dark:text-zinc-400 dark:hover:text-brand-400',
          ]}
          hreflang={code === 'pt-br' ? 'pt-BR' : 'en'}
          aria-current={code === currentLang ? 'true' : 'false'}
          title={label}
        >
          {code === 'pt-br' ? 'PT' : 'EN'}
        </a>
      </>
    ))
  }
</div>
