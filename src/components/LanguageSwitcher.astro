---
import { getLangFromUrl, getAlternatePath } from '~/i18n/utils';
import { languages, type Lang } from '~/i18n/ui';

const currentLang = getLangFromUrl(Astro.url);
const entries = Object.entries(languages) as [Lang, string][];
---

<div class="lang-sw">
  {entries.map(([code, label], i) => (
    <>
      {i > 0 && <span class="lang-sw__sep" aria-hidden="true">/</span>}
      <a
        href={getAlternatePath(Astro.url, code)}
        class:list={['lang-sw__link', { 'lang-sw__link--active': code === currentLang }]}
        hreflang={code === 'pt-br' ? 'pt-BR' : 'en'}
        aria-current={code === currentLang ? 'true' : 'false'}
        title={label}
      >
        {code === 'pt-br' ? 'PT' : 'EN'}
      </a>
    </>
  ))}
</div>

<style>
  .lang-sw {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: var(--fs-13);
    font-family: var(--font-mono);
  }
  .lang-sw__sep {
    color: var(--ink-300);
    padding: 0 1px;
  }
  .lang-sw__link {
    padding: 3px 6px;
    border-radius: var(--r-sm);
    color: var(--ink-500);
    font-weight: 500;
    transition: color var(--dur-fast), background var(--dur-fast);
    letter-spacing: var(--tracking-wide);
  }
  .lang-sw__link:hover {
    color: var(--text);
    background: var(--surface-alt);
  }
  .lang-sw__link--active {
    color: var(--text);
    font-weight: 700;
  }
</style>
