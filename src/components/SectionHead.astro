---
interface Props {
  num?: string;
  title: string;
  lede?: string;
}

const { num, title, lede } = Astro.props;
---

<div class="section__head">
  <div class="section__title-wrap">
    {num && <span class="section__num">{num}</span>}
    <h2 class="section__title" set:html={title} />
    {lede && <p class="section__lede">{lede}</p>}
  </div>
  <slot />
</div>
