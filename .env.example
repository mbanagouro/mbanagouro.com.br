# Copy this file to .env and fill in your actual IDs.
# These vars are inlined at build time via Astro's PUBLIC_ prefix.

# Google Analytics 4 — formato: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Meta (Facebook) Pixel — id numérico
PUBLIC_META_PIXEL_ID=

# Site URL (override em previews; produção lê de astro.config.mjs)
# PUBLIC_SITE_URL=https://mbanagouro.com.br
